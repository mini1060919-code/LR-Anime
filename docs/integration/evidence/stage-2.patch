@@ -0,0 +1,127 @@
+/* Original CSS artwork and theme. No external images, fonts, or asset requests. */
+:root[data-ui-theme='anime-survival'] {
+  --ui-ink: #edf3ff;
+  --ui-muted: #9fb1ca;
+  --ui-panel: #121d31f2;
+  --ui-line: #5b718f;
+  --ui-accent: #88e5db;
+  --ui-alert: #ffad9d;
+  color-scheme: dark;
+  font-family: 'Noto Sans TC', 'Microsoft JhengHei', system-ui, sans-serif;
+}
+[data-ui-theme] #ui { color: var(--ui-ink); font-family: inherit; }
+[data-ui-theme] #ui button, [data-ui-theme] #ui select {
+  font: inherit; color: var(--ui-ink); background: #182840;
+  border: 1px solid var(--ui-line); border-radius: 5px;
+}
+[data-ui-theme] #ui button:hover, [data-ui-theme] #ui select:hover { border-color: var(--ui-accent); background: #233d52; }
+[data-ui-theme] #ui button:focus-visible, [data-ui-theme] #ui select:focus-visible { outline: 2px solid var(--ui-accent); outline-offset: 3px; }
+[data-ui-theme] #ui button:disabled { opacity: .45; cursor: default; }
+[data-ui-theme] .screen-overlay { background: radial-gradient(ellipse at 20% 30%, #183347b8, #080f1be8 75%); }
+[data-ui-theme] .screen-panel {
+  position: relative; border: 1px solid var(--ui-line); border-top: 3px solid var(--ui-accent);
+  background: linear-gradient(135deg, #1c2d44f5, #0d1628f5); box-shadow: 0 20px 70px #0008;
+  border-radius: 8px; max-height: 92dvh; overflow: auto;
+}
+[data-ui-theme] .screen-title { color: var(--ui-ink); letter-spacing: .12em; text-shadow: 0 0 24px #88e5db35; }
+[data-ui-theme] .screen-subtitle, [data-ui-theme] .screen-goal { color: #bed0e5; line-height: 1.8; }
