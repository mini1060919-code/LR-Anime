diff --git a/scripts/verify-anime.mjs b/scripts/verify-anime.mjs
new file mode 100644
index 0000000..8e53241
--- /dev/null
+++ b/scripts/verify-anime.mjs
@@ -0,0 +1,29 @@
+// Source pack integrity; sheets are preserved but never downloaded by the UI.
+import {readFile, readdir} from 'node:fs/promises';
+import {createHash} from 'node:crypto';
+import {ANIME_CAST,ANIME_EXPRESSIONS} from '../src/characters/anime.js';
+const root=new URL('../public/assets/anime/',import.meta.url);
+const source=JSON.parse(await readFile(new URL('manifest.json',root),'utf8'));
+const runtime=JSON.parse(await readFile(new URL('../public/assets/portraits/manifest.v1.json',import.meta.url),'utf8'));
+const inspection=JSON.parse(await readFile(new URL('../docs/M3-ART-INSPECTION.json',import.meta.url),'utf8'));
+if(source.schemaVersion!==1 || Object.keys(source.characters).sort().join()!==Object.keys(ANIME_CAST).sort().join())throw new Error('Anime source cast mismatch');
+for(const [id,setId] of Object.entries(ANIME_CAST)){
+ const char=source.characters[id],set=runtime.portraitSets[setId];
+ if(set.sourceCharacterId!==id)throw new Error('Anime character mapping mismatch');
+ for(const [key,path] of Object.entries({full:char.full,avatar:char.avatar,...char.expressions})){
+  if(!/^(portraits|avatars|expressions)\/[a-z0-9_]+\.png$/.test(path))throw new Error('Unsafe anime source path');
+  const aid=key==='full'?set.fullAssetId:key==='avatar'?set.avatarAssetId:set.expressions[key];
+  if(runtime.assets[aid]?.path!==`assets/anime/${path}`)throw new Error('Anime source/runtime mismatch');
+ }
+ if(Object.keys(char.expressions).sort().join()!==[...ANIME_EXPRESSIONS].sort().join())throw new Error('Anime expression mismatch');
+}
+const paths=[];
+for(const folder of ['portraits','avatars','expressions','sheets'])for(const file of await readdir(new URL(folder+'/',root)))paths.push(`public/assets/anime/${folder}/${file}`);
+if(paths.length!==32 || inspection.length!==32 || paths.some(path=>!inspection.some(row=>row.path===path)))throw new Error('Anime inventory mismatch');
+for(const row of inspection){
+ const path=row.path.replace('public/assets/anime/','');
+ if(!/^(portraits|avatars|expressions|sheets)\/[a-z0-9_]+\.png$/.test(path))throw new Error('Unsafe inspection path');
+ const bytes=await readFile(new URL(path,root));
+ if(bytes.length!==row.bytes || createHash('sha256').update(bytes).digest('hex')!==row.sha256 || bytes.subarray(0,8).toString('hex')!=='89504e470d0a1a0a' || bytes.readUInt32BE(16)!==row.size[0] || bytes.readUInt32BE(20)!==row.size[1] || bytes[25]!==6)throw new Error(`Anime PNG invalid: ${path}`);
+}
+console.log('Anime source pack: 32 exact RGBA PNGs verified; 4 stable cast mappings and 20 expressions.');
diff --git a/scripts/verify-portraits.mjs b/scripts/verify-portraits.mjs
new file mode 100644
index 0000000..2658e48
--- /dev/null
+++ b/scripts/verify-portraits.mjs
@@ -0,0 +1,49 @@
+// Validate approved local art before build. Draft inventory is not finished artwork.
+import { readFile, realpath } from 'node:fs/promises';
+import { resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createHash } from 'node:crypto';
+import { approvedAsset } from '../src/characters/portraits.js';
+
+export async function verifyPortraitInventory(manifest,rights,readAsset) {
+  if(manifest.schemaVersion!==1 || rights.schemaVersion!==1 || !manifest.assets || !manifest.portraitSets)throw new Error('Invalid portrait manifest schema.');
+  const kinds=new Map();
+  for(const [id,set] of Object.entries(manifest.portraitSets)) {
+    if(!/^pset\.[a-z0-9_.-]+$/.test(id) || set.expressions?.neutral!==set.neutralAssetId)throw new Error('Invalid portrait set.');
+    for(const assetId of Object.values(set.expressions ?? {})) {
+      if(!Object.hasOwn(manifest.assets,assetId))throw new Error(`Missing portrait asset ID: ${assetId}`);
+      kinds.set(assetId,'portrait');
+    }
+    if(set.fullAssetId) {
+      if(!Object.hasOwn(manifest.assets,set.fullAssetId))throw new Error('Missing full portrait asset ID.');
+      kinds.set(set.fullAssetId,'full');
+    }
+    if(set.avatarAssetId) {
+      if(!Object.hasOwn(manifest.assets,set.avatarAssetId))throw new Error('Missing avatar asset ID.');
+      kinds.set(set.avatarAssetId,'avatar');
+    }
+  }
+  let approved=0,draft=0;
+  for(const [id,asset] of Object.entries(manifest.assets)) {
+    if(!kinds.has(id))throw new Error(`Unreferenced asset: ${id}`);
+    if(asset.status==='draft'){draft++;continue;}
+    if(!approvedAsset(asset,rights,kinds.get(id)))throw new Error(`Artwork approval/rights incomplete: ${id}`);
+    const bytes=await readAsset(asset.path);
+    if(bytes.byteLength!==asset.byteLength || createHash('sha256').update(bytes).digest('hex')!==asset.sha256)throw new Error(`Artwork bytes/checksum mismatch: ${id}`);
+    // Actual decoding/dimensions are checked again by the browser before display.
+    if(asset.path.endsWith('.png') && (bytes.length<24 || bytes.readUInt32BE(0)!==0x89504e47 || bytes.readUInt32BE(16)!==asset.width || bytes.readUInt32BE(20)!==asset.height))throw new Error(`PNG dimensions/header mismatch: ${id}`);
+    approved++;
+  }
+  return {approved,draft};
+}
+if(process.argv[1] && resolve(process.argv[1])===fileURLToPath(import.meta.url)) {
+  const root=resolve(fileURLToPath(new URL('../public/',import.meta.url)));
+  const manifest=JSON.parse(await readFile(resolve(root,'assets/portraits/manifest.v1.json'),'utf8'));
+  const rights=JSON.parse(await readFile(resolve(root,'assets/portraits/rights.v1.json'),'utf8'));
+  const result=await verifyPortraitInventory(manifest,rights,async path=>{
+    const actual=await realpath(resolve(root,path));
+    if(!actual.startsWith(root+sep))throw new Error('Artwork path escapes public root.');
+    return readFile(actual);
+  });
+  console.log(`Portrait inventory: ${result.approved} approved images, ${result.draft} draft slots. Draft slots use the default silhouette.`);
+}
